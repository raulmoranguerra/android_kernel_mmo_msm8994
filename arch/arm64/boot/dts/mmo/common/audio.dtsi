&soc {
	sound {
		qcom,audio-routing =
			"AIF4 VI", "MCLK",
			"RX_BIAS", "MCLK",
			"LDO_H", "MCLK",
			"MADINPUT", "MCLK",
			"ultrasound amp", "LINEOUT1",
			"ultrasound amp", "LINEOUT3",
			"AMIC1", "MIC BIAS1 Internal1",
			"MIC BIAS1 Internal1", "Handset Mic",
			"AMIC2", "MIC BIAS2 External",
			"MIC BIAS2 External", "Headset Mic",
			"AMIC3", "MIC BIAS2 External",
			"MIC BIAS2 External", "ANCRight Headset Mic",
			"AMIC4", "MIC BIAS2 External",
			"MIC BIAS2 External", "ANCLeft Headset Mic",
			"AMIC5", "MIC BIAS3 External",
			"MIC BIAS3 External", "Analog Mic5",
			"AMIC6", "MIC BIAS4 External",
			"MIC BIAS4 External", "Analog Mic6",
			"DMIC1", "MIC BIAS1 External",
			"MIC BIAS1 External", "Digital Mic1",
			"DMIC2", "MIC BIAS1 External",
			"MIC BIAS1 External", "Digital Mic2",
			"DMIC3", "MIC BIAS3 External",
			"MIC BIAS3 External", "Digital Mic3",
			"DMIC4", "MIC BIAS3 External",
			"MIC BIAS3 External", "Digital Mic4",
			"DMIC5", "MIC BIAS4 External",
			"MIC BIAS4 External", "Digital Mic5",
			"DMIC6", "MIC BIAS4 External",
			"MIC BIAS4 External", "Digital Mic6";

		qcom,us-euro-gpios = <&pm8994_mpps 2 0>;
		qcom,cdc-micbias2-headset-only;
		qcom,mbhc-audio-jack-type = "4-pole-jack";
		qcom,mbhc-insert-detect-inverted;
		qcom,ext-ult-spk-amp-gpio = <&pmi8994_gpios 1 0>;
		asoc-codec = <&stub_codec>;
		asoc-codec-names = "msm-stub-codec.1";
	};
};

/*
 * The main loudspeaker hangs off a TI TAS2553 (register compatible with the
 * TAS2552) rather than the WCD9330's own speaker driver. It is controlled
 * over BLSP1 I2C-2 and fed audio over Quaternary MI2S.
 *
 * The MI2S pins are claimed here as the amplifier's "default" pinctrl state
 * instead of being switched by the sound card: the ASoC machine driver
 * already owns a pinctrl handle for the sound node, and pinctrl_get() hands
 * back that same handle, so a second consumer selecting states on it would
 * silently tear down the primary MI2S and AuxPCM pin configuration. Nothing
 * else on the board can use GPIO 58/59/62, so a static mux is correct.
 */
&i2c_2 {
	status = "ok";

	tas2552: tas2552@40 {
		compatible = "ti,tas2552";
		reg = <0x40>;

		ti,enable-gpio = <&pm8994_gpios 12 0>;

		pinctrl-names = "default";
		pinctrl-0 = <&quat_mi2s_active>, <&quat_mi2s_sd2_active>;
	};
};

/*
 * Amplifier enable. The schematic labels TLMM GPIO 144 as the speaker enable,
 * but on production hardware the line that actually gates the TAS2553 is
 * PM8994 GPIO 12 -- with it low the chip does not acknowledge on I2C at all.
 */
&pm8994_gpios {
	gpio@cb00 {
		status = "ok";
		qcom,pin-num = <12>;
		qcom,mode = <1>;		/* digital output */
		qcom,output-type = <0>;		/* CMOS */
		qcom,invert = <0>;		/* start low, amp off */
		qcom,pull = <5>;		/* no pull */
		qcom,vin-sel = <2>;		/* 1.8 V */
		qcom,src-sel = <0>;		/* constant */
		qcom,out-strength = <1>;	/* low */
		qcom,master-en = <1>;
	};
};

&slim_msm {
	tomtom_codec {
		qcom,cdc-micbias1-ext-cap;
		qcom,cdc-micbias3-ext-cap;
		qcom,cdc-micbias4-ext-cap;
		cdc-vdd-spkdrv-supply = <&pmi8994_boost_pin_ctrl>;
		qcom,cdc-vdd-spkdrv-voltage = <5000000 5000000>;
		qcom,cdc-vdd-spkdrv-current = <600000>;

		cdc-vdd-spkdrv-2-supply = <&pmi8994_boost_pin_ctrl>;
		qcom,cdc-vdd-spkdrv-2-voltage = <5000000 5000000>;
		qcom,cdc-vdd-spkdrv-2-current = <600000>;

		qcom,cdc-on-demand-supplies = "cdc-vdd-spkdrv",
					      "cdc-vdd-spkdrv-2";
	};
};